{
  "name": "dsh-zh-thinking",
  "version": "0.1.2",
  "description": "Local DSH host plugin: request-scoped Chinese language preference for D:\\PythonProject\\memPaper only, with explicit user-language exceptions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "runtime": ">=0.1.1-rc.1 <0.3.0-0"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test:kernel": "node test/kernel-smoke.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "chinese",
    "zh",
    "simplified-chinese",
    "chinese-thinking",
    "chain-of-thought",
    "thinking",
    "language-control",
    "中文",
    "中文思考",
    "思维链",
    "简体中文"
  ],
  "author": "yingjian666",
  "repository": {
    "type": "git",
    "url": "https://github.com/yingjian666/dsh-zh-thinking.git"
  },
  "homepage": "https://github.com/yingjian666/dsh-zh-thinking#readme",
  "bugs": {
    "url": "https://github.com/yingjian666/dsh-zh-thinking/issues"
  },
  "license": "MIT"
}
